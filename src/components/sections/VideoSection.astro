---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Button from '../ui/Button.astro';
import VideoEmbed from '../islands/VideoEmbed';
import { links, event, video } from '../../data/site';
import posterSrc from '../../assets/images/sharpen-2026-video-poster.avif';
import PriceTag from '../islands/PriceTag';
import { tiers } from '../../data/tickets';

const earlyPrice = tiers.find((t) => t.id === 'early-bird')!.price;
const regularPrice = tiers.find((t) => t.id === 'regular')!.price;
const initialEarly = Date.now() < new Date(event.earlyBirdEndsAt).getTime();


/* Shipped as-is rather than through getImage. The asset is already AVIF at
   exactly the width this slot needs — 1600 covers the ~780px paint at 2x — so
   re-encoding it here would only spend a second lossy pass on an image that is
   already at its delivery size. Astro still content-hashes the emitted file. */
const poster = posterSrc;

const points = [
  ['Fifty owners', 'One room, two full days.'],
  ['Every session', 'Ends in something written down.'],
  ['You leave with', 'A One-Page Strategic Plan for 2027.'],
];
---

<Section tone="dark" spacing="lg" clip>
  <Container width="wide">
    <div
      class="grid grid-cols-[0.95fr_1.05fr] items-center gap-20 tablet:gap-12 landscape:grid-cols-1 landscape:gap-12"
    >
      <div class="reveal flex flex-col gap-10 landscape:gap-8" data-reveal>
        <SectionHeading tone="light">Here's what you're walking into.</SectionHeading>

        <p class="max-w-[52ch] text-body text-white/75">{event.hero.lines[1]}</p>

        <dl class="grid grid-cols-3 gap-8 portrait:grid-cols-1 portrait:gap-6">
          {
            points.map(([term, detail]) => (
              <div class="flex flex-col gap-2 border-t border-line-dark pt-5">
                <dt class="label text-white/55">{term}</dt>
                <dd class="text-body text-white">{detail}</dd>
              </div>
            ))
          }
        </dl>

        {/* The film plays in place, so the band no longer needs a "watch"
            button — the ticket is the only action left to offer. */}
        <div class="flex flex-wrap items-center gap-4 portrait:flex-col portrait:items-stretch portrait:gap-3">
          <Button href={links.checkout} variant="outlineLight" size="lg" external stack>
            Reserve your spot —{' '}
            <PriceTag
              early={earlyPrice}
              regular={regularPrice}
              earlyBirdEndsAt={event.earlyBirdEndsAt}
              initialEarly={initialEarly}
              client:load
            />
          </Button>
        </div>
      </div>

      <div class="reveal w-full" data-reveal data-reveal-delay="140">
        {/*
          Click-to-play facade: the 36MB file is not requested until someone
          asks for it. See the note on `video` in data/site.ts.
        */}
        <VideoEmbed
          src={video.src}
          title={video.title}
          fallbackHref={links.instagram}
          fallbackLabel="Watch on Instagram"
          brief={video.title}
          poster={poster.src}
          posterPosition="50% 50%"
          client:visible
        />
        <p class="label mt-4 text-white/45">
          {video.title} · {video.context} · {video.runtime}
        </p>
      </div>
    </div>
  </Container>
</Section>
