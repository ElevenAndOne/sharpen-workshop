---
/**
 * Bring a colleague — a 50/50 split. The photograph makes the point (two owners
 * at a table); the copy just names the offer and the code.
 */
import Section from '../layout/Section.astro';
import Badge from '../ui/Badge.astro';
import ImageFrame from '../ui/ImageFrame.astro';
import { bringAColleague } from '../../data/tickets';
import pair from '../../assets/images/deb-client-red-wall.jpg';
---

<Section tone="white" spacing="none" clip>
  <div class="grid grid-cols-2 landscape:grid-cols-1">
    <div class="reveal-clip relative min-h-[44rem] tablet:min-h-[36rem] landscape:aspect-[16/10] landscape:min-h-0 portrait:aspect-[4/3]" data-reveal>
      <ImageFrame
        fill
        image={pair}
        alt="Chef Deb and a culinary business owner working side by side at a table."
        sizes="(width <= 1023px) 100vw, 50vw"
        position="50% 40%"
      />
    </div>

    <div
      class="flex flex-col justify-center px-24 py-28 tablet:px-14 tablet:py-20 landscape:px-6 landscape:py-16 portrait:px-5 portrait:py-14"
    >
      <div class="reveal flex max-w-[32rem] flex-col gap-6" data-reveal>
        <Badge tone="brand">Bring a colleague</Badge>
        <h2 class="text-display text-ink-deep">{bringAColleague.heading}</h2>
        <p class="text-body text-slate">{bringAColleague.body}</p>

        {/* Offer and code read as one line at heading size — the client asked
            for "with code BAC" to carry real weight, not sit in a footnote. */}
        <div class="mt-4 border-t border-line pt-6">
          <p
            class="flex flex-wrap items-baseline gap-x-3 gap-y-2 font-display text-heading font-black tracking-[-0.02em] text-ink-deep"
          >
            <span>{bringAColleague.offer}</span>
            <span class="text-slate">with code</span>
            <span class="inline-flex items-center rounded-[2px] bg-gold px-3 py-0.5 text-gray-900">
              {bringAColleague.code}
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>
</Section>
