---
/**
 * Hero — one photograph, one job.
 *
 * A full-bleed shot of the SHARPEN room carries the first screen. A scrim
 * rises from the bottom-left so the headline and CTAs read, while the room
 * stays visible across the rest of the frame. Nothing else competes.
 */
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import ImageFrame from '../ui/ImageFrame.astro';
import { event, links } from '../../data/site';
import room from '../../assets/images/sharpen-room-hands-raised.jpg';
import PriceTag from '../islands/PriceTag';
import { tiers } from '../../data/tickets';

const earlyPrice = tiers.find((t) => t.id === 'early-bird')!.price;
const regularPrice = tiers.find((t) => t.id === 'regular')!.price;
const initialEarly = Date.now() < new Date(event.earlyBirdEndsAt).getTime();

---

<Section tone="dark" spacing="none" clip class="flex min-h-[min(88svh,60rem)] landscape:min-h-[min(84svh,52rem)]">
  <!-- ===== photograph + legibility scrim (between Section and Container) ===== -->
  <ImageFrame
    fill
    image={room}
    alt="A full room of culinary business owners at SHARPEN, seated at long tables with worksheets, several hands raised, Chef Deb at the front."
    priority
    sizes="100vw"
    position="50% 38%"
    class=""
  />
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-t from-gray-950/90 via-gray-950/40 to-gray-950/5 portrait:from-gray-950/95 portrait:via-gray-950/60"
    aria-hidden="true"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-r from-gray-950/60 via-gray-950/10 to-transparent landscape:hidden"
    aria-hidden="true"
  >
  </div>

  <Container width="wide" class="flex flex-col justify-end pt-44 pb-20 tablet:pt-36 tablet:pb-16 landscape:pt-32 landscape:pb-14 portrait:pt-28 portrait:pb-12">
    <div class="reveal-lines flex max-w-[40rem] flex-col" data-reveal>
      <h1 class="text-display text-white">
        <span class="line" style="--i:0"><span class="block">{event.name}</span></span>
      </h1>

      <p class="mt-3 text-tagline text-heading text-white">
        <span class="line" style="--i:1"><span class="block">{event.hero.headline}</span></span>
      </p>

      <p class="mt-5 max-w-[46ch] text-body text-white/85 portrait:mt-4">
        <span class="line" style="--i:2"><span class="block">{event.hero.subhead}</span></span>
      </p>

      <p class="mt-6 max-w-[46ch] text-body text-white/85 portrait:mt-5">
        <span class="line" style="--i:3">
          <span class="block">
            <strong class="font-black text-white">{event.hero.heading}</strong>
            {' '}{event.hero.body}
          </span>
        </span>
      </p>

      <p class="mt-4 max-w-[46ch] text-body text-white/70">
        <span class="line" style="--i:4"><span class="block">{event.hero.lines[0]}</span></span>
      </p>

      <!-- CTA hierarchy: one solid, one outline, one text link -->
      <div class="line mt-9 portrait:mt-7" style="--i:5">
        <div class="flex flex-wrap items-center gap-4 portrait:flex-col portrait:items-stretch portrait:gap-3">
          <Button href={links.checkout} variant="primary" size="lg" external stack>
            Grab your seat —{' '}
            <PriceTag
              early={earlyPrice}
              regular={regularPrice}
              earlyBirdEndsAt={event.earlyBirdEndsAt}
              initialEarly={initialEarly}
              client:load
            />
          </Button>
          <Button href="#sponsor" variant="outlineLight" size="lg" stack>Become a sponsor</Button>
          <Button href="#agenda" variant="quiet" class="text-white portrait:mt-2" stack>
            Preview the agenda
          </Button>
        </div>
      </div>

      <p class="label mt-8 text-white/60 portrait:mt-6">
        <span class="line" style="--i:6"><span class="block">{event.edition} · {event.dateShort} · {event.city} · {event.seats} seats</span></span>
      </p>
    </div>
  </Container>
</Section>
