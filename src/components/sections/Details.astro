---
import Section from '../layout/Section.astro';
import Container from '../layout/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ImageFrame from '../ui/ImageFrame.astro';
import { details } from '../../data/details';
/**
 * The venue is the point of this slot: the workshop sits on the third floor of
 * Meacham International Airport Conference Center, looking out over the
 * runways.
 *
 * The frame is taller than the photograph is wide, so the crop is steered onto
 * the glass tower and the building's name plate. That also means cover-crop
 * scales the shot by height — it paints roughly 75vw wide and is clipped — so
 * `sizes` below describes that width, not the 40vw box. Declare the box and
 * the browser picks a candidate too small and upscales it.
 */
import venue from '../../assets/images/meacham-international-airport-conference-center.png';
---

<Section id="details" tone="gray" spacing="lg">
  <Container width="wide" edges>
    <div
      class="grid grid-cols-[1.15fr_0.85fr] items-stretch gap-20 tablet:gap-12 landscape:grid-cols-1 landscape:gap-10"
    >
      <div>
        <SectionHeading class="reveal" data-reveal>Everything you need to plan the trip.</SectionHeading>

        <div
          class="mt-12 grid grid-cols-2 gap-5 landscape:mt-10 portrait:mt-8 portrait:grid-cols-1"
        >
          {
            details.map((block, i) => (
              <div
                class="reveal card-rule group relative flex flex-col gap-3 bg-white p-7 portrait:p-6"
                data-reveal
                data-reveal-delay={i * 80}
              >
                <h3 class="label text-slate">{block.label}</h3>

                <ul class="flex flex-col gap-1.5">
                  {block.lines.map((line) => (
                    <li class="text-body leading-snug text-ink">{line}</li>
                  ))}
                </ul>

                {block.note && <p class="text-body leading-snug text-slate italic">{block.note}</p>}

                {block.link && (
                  <a
                    href={block.link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-fit text-body text-brand underline decoration-brand/40 underline-offset-4 transition-colors duration-200 hover:decoration-brand"
                  >
                    {block.link.label}
                    <span class="sr-only"> (opens in a new tab)</span>
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="reveal-clip relative min-h-[34rem] overflow-hidden landscape:order-first landscape:aspect-[16/9] landscape:min-h-0 portrait:aspect-[4/3]"
        data-reveal
        data-reveal-delay="120"
      >
        <ImageFrame
          fill
          image={venue}
          alt="The exterior of Meacham International Airport Conference Center in Fort Worth — a glass and steel building under a blue sky, with a light aircraft overhead."
          sizes="(width <= 1023px) 100vw, 75vw"
          position="57% 50%"
        />
      </div>
    </div>
  </Container>
</Section>
