---
import type { HTMLAttributes } from 'astro/types';

export type ButtonVariant =
  | 'primary'    /* solid brand red — the ticket action */
  | 'gold'       /* solid gold — used sparingly */
  | 'outline'    /* red outline on light grounds */
  | 'outlineLight' /* white outline on dark grounds */
  | 'quiet';     /* text + rule */

export type ButtonSize = 'sm' | 'md' | 'lg';

interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  href?: string;
  variant?: ButtonVariant;
  size?: ButtonSize;
  /** Opens in a new tab and adds the accessible hint. */
  external?: boolean;
  full?: boolean;
  /** Portrait phones: filled/outline buttons stretch full width; a quiet
      text button centres itself instead so it lines up with them. */
  stack?: boolean;
  type?: 'button' | 'submit';
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  full = false,
  stack = false,
  type,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';

const base =
  'group/btn relative inline-flex items-center justify-center gap-2.5 rounded-[2px] ' +
  'font-display font-black uppercase tracking-[0.08em] text-center ' +
  'transition-[background-color,color,border-color] duration-200 ' +
  'disabled:pointer-events-none disabled:opacity-45';

const variants: Record<ButtonVariant, string> = {
  /* Solid red with the brand's thin offset outline sitting behind it; the
     outline tucks in on hover so the button reads as pressed. */
  primary:
    'bg-brand text-white hover:bg-brand-deep ' +
    'after:pointer-events-none after:absolute after:inset-0 after:-z-10 after:translate-x-[4px] after:translate-y-[4px] ' +
    'after:rounded-[2px] after:border after:border-brand after:transition-transform after:duration-200 ' +
    'hover:after:translate-x-0 hover:after:translate-y-0',
  gold: 'bg-gold text-gray-900 hover:bg-gold-deep hover:text-white',
  outline:
    'border border-gray-900 text-gray-900 bg-transparent hover:bg-gray-900 hover:text-white',
  outlineLight:
    'border border-white/40 text-white bg-transparent hover:border-white hover:bg-white hover:text-gray-900',
  quiet:
    'text-current underline decoration-current/30 decoration-1 underline-offset-[6px] hover:decoration-current',
};

const sizes: Record<ButtonSize, string> = {
  sm: 'text-small px-4 py-2.5',
  md: 'text-small px-6 py-3.5 portrait:px-5',
  lg: 'text-small px-7 py-4 portrait:px-6 portrait:py-3.5',
};

const quiet = variant === 'quiet';
---

<Tag
  href={href}
  type={Tag === 'button' ? (type ?? 'button') : undefined}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class:list={[
    base,
    variants[variant],
    !quiet && sizes[size],
    quiet && 'px-0 py-3 text-small',
    full && 'w-full',
    stack && !quiet && 'portrait:w-full',
    stack && quiet && 'portrait:mx-auto',
    className,
  ]}
  {...rest}
>
  <slot />
  {
    external && (
      <>
        <svg
          class="size-3 shrink-0 opacity-70 transition-transform duration-200 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5"
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path d="M3 9L9 3M9 3H4.5M9 3v4.5" stroke-linecap="square" />
        </svg>
        <span class="sr-only">(opens in a new tab)</span>
      </>
    )
  }
</Tag>
