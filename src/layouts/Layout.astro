---
import '@fontsource-variable/mulish';
import '../styles/global.css';
import { event, links, contacts, social } from '../data/site';
import { faqs } from '../data/faq';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

/**
 * Absolute URLs for everything a crawler or a share card needs. `Astro.site`
 * is the one place the production origin is declared (astro.config.mjs), so
 * moving the page to another host is a one-line change here and nowhere else.
 */
const site = Astro.site ?? new URL('https://sharpen.chefdeb.com');
const abs = (p: string) => new URL(p, site).href;

const {
  /* Kept under ~60 characters so Google shows it whole rather than truncating
     mid-phrase. The tagline is long and lives in og:site_name and the H1. */
  title = `${event.name} — Food & Hospitality Owners' Workshop | Chef Deb`,
  /* ~155 characters for the same reason. The old default ran to 235 and was
     cut off in the middle of the seat count. */
  description = `Two days on price, cost and volume — run against your own numbers — and a 90-day plan for 2027. ${event.dateShort}, ${event.city}. ${event.seats} seats.`,
  /**
   * Self-canonical. This previously pointed at chefdeb.com/sharpen-2-day-workshop/,
   * which returns 404 — so the page was handing its ranking signal to a dead
   * URL. See README for the open question of what happens to the existing
   * WordPress page at /sharpen-2027/ once this one is live.
   */
  canonical = abs(Astro.url.pathname),
} = Astro.props;

const ogImage = abs('/og-image.jpg');

/**
 * One linked graph rather than a lone Event node.
 *
 * Search engines and answer engines resolve entities and the relationships
 * between them, so the organisation, the page, the event and the questions are
 * declared once each and cross-referenced by `@id`. That lets a crawler follow
 * "this event is run by this organisation, which owns this site" instead of
 * inferring it from prose.
 */
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${links.home}#organization`,
      name: 'Chef Deb Coaching',
      url: links.home,
      logo: {
        '@type': 'ImageObject',
        url: abs('/brand/chefdeb-logo-white.png'),
      },
      sameAs: social.map((s) => s.href),
      contactPoint: contacts.map((c) => ({
        '@type': 'ContactPoint',
        contactType: 'Registration and attendee enquiries',
        name: c.name,
        email: c.email,
        telephone: c.phoneHref.replace('tel:', ''),
        availableLanguage: 'English',
      })),
    },
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      url: site.origin,
      name: `${event.name} — Chef Deb Coaching`,
      inLanguage: 'en-US',
      publisher: { '@id': `${links.home}#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'en-US',
      isPartOf: { '@id': `${site.origin}/#website` },
      about: { '@id': `${canonical}#event` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
    },
    {
      '@type': 'Person',
      '@id': `${links.home}#chefdeb`,
      name: 'Chef Deb',
      jobTitle: 'Business coach for food, beverage and hospitality owners',
      url: links.home,
      worksFor: { '@id': `${links.home}#organization` },
    },
    {
      '@type': 'BusinessEvent',
      '@id': `${canonical}#event`,
      name: event.name,
      description,
      url: canonical,
      image: [ogImage],
      startDate: '2027-01-28T09:00:00-06:00',
      endDate: '2027-01-29T17:00:00-06:00',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      inLanguage: 'en-US',
      isAccessibleForFree: false,
      maximumAttendeeCapacity: event.seats,
      location: {
        '@type': 'Place',
        name: event.venue.name,
        address: {
          '@type': 'PostalAddress',
          streetAddress: event.venue.detail,
          addressLocality: 'Fort Worth',
          addressRegion: 'TX',
          addressCountry: 'US',
        },
      },
      organizer: { '@id': `${links.home}#organization` },
      performer: { '@id': `${links.home}#chefdeb` },
      audience: {
        '@type': 'BusinessAudience',
        name: 'Food, beverage and hospitality business owners',
      },
      offers: [
        {
          '@type': 'Offer',
          name: 'Early Bird',
          price: '395',
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          url: links.checkout,
          validThrough: event.earlyBirdEndsAt,
          category: 'primary',
        },
        {
          '@type': 'Offer',
          name: 'Regular',
          price: '495',
          priceCurrency: 'USD',
          availability: 'https://schema.org/InStock',
          url: links.checkout,
          validFrom: event.earlyBirdEndsAt,
          validThrough: event.registrationClosesAt,
          category: 'primary',
        },
      ],
    },
    {
      /**
       * The FAQ answers are already written as self-contained passages — one
       * question answered completely, no "as mentioned above". That is the
       * unit an answer engine lifts, so marking them up is what makes the page
       * quotable rather than merely crawlable.
       */
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      inLanguage: 'en-US',
      isPartOf: { '@id': `${canonical}#webpage` },
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!--
      Icons. These were the stock Astro set until Sept 2026 — the framework's
      own rocket. The mark is the knife-"A" lifted out of the client's SHARPEN
      wordmark, white on brand red; see scripts/generate-brand-assets.mjs.
    -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Let Google use the full-size share image and an untruncated snippet. -->
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!--
      The page previously declared summary_large_image while supplying no
      image at all, so every share rendered as a bare grey link.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Chef Deb Coaching" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`SHARPEN 2027 — ${event.dateShort}, ${event.city}. A full room of food and hospitality business owners at work, hands raised.`}
    />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#161616" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(graph)}
    />
  </head>

  <body id="top">
    <!--
      DIRECTION CONTRACT — SHARPEN 2027 landing page
      THESIS: A working room, not a stage. One photograph of owners at work carries
        the first screen; the page refuses the conference masthead — giant type,
        numbered sections, patterned backgrounds — and lets imagery persuade.
      OWN-WORLD: Neutral greys carry every surface; red is the only action colour
        and the tagline's voice; gold appears only as a hint (a saving, a TBD).
        Mulish Black headings, Mulish Italic for Deb's voice. Sharp red buttons
        with the brand's thin offset outline. Candid documentary photography,
        full-bleed. Whitespace separates; no rules, no patterns.
      STORY: An owner sees a real room of peers working, understands it is two
        days on the business (50 seats, $395), and grabs a seat — or previews the
        agenda, or enquires about sponsoring.
      FIRST VIEWPORT: Red announcement strip; dark nav; full-bleed photo of the
        SHARPEN room with a bottom-left gradient; headline "SHARPEN 2027" (~4rem,
        white) over an italic tagline, one proof line, then the CTA row: solid
        "Reserve your spot — $395", outline "Become a sponsor", text "Preview the
        agenda".
      FORM: Brand-native, pinned by the client (chefdeb.com full-bleed hero and
        the live /sharpen-2027/ rhythm); no direction roll — pinned beats the roll.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the
        finish review, the verdict, DESIGN.md, and every shipping raster carrying
        its provenance.
    -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-[2px] focus:bg-brand focus:px-5 focus:py-3 focus:font-display focus:text-small focus:font-black focus:tracking-[0.1em] focus:text-white focus:uppercase"
    >
      Skip to content
    </a>

    <slot />

    <!--
      Scroll reveal, strictly additive.

      Content is visible by default. This only hides an element it can prove
      it will bring back: the sweep runs on rAF with a timer backup, a hidden
      tab or reduced motion skips the animation entirely, and backgrounding
      the tab mid-scroll shows whatever is left.
    -->
    <script is:inline>
      (() => {
        const targets = Array.from(document.querySelectorAll('[data-reveal]'));
        if (!targets.length) return;

        const show = (el) => el.setAttribute('data-reveal', 'shown');

        /* Bail out to plain visible content when we cannot drive an animation. */
        if (
          document.hidden ||
          window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          targets.forEach(show);
          return;
        }

        const threshold = () => window.innerHeight * 0.92;

        /* Everything starts pending and the first sweep runs on the next
           frame, so above-the-fold blocks (the hero) play their entrance.
           The timer and visibility fallbacks below mean nothing can be left
           hidden if that frame never comes. */
        targets.forEach((el) => el.setAttribute('data-reveal', 'pending'));
        let pending = targets;

        let queued = false;

        const sweep = () => {
          queued = false;
          const limit = threshold();
          const still = [];

          for (const el of pending) {
            if (el.getBoundingClientRect().top < limit) {
              const delay = Number(el.getAttribute('data-reveal-delay') || 0);
              if (delay) window.setTimeout(() => show(el), delay);
              else show(el);
            } else {
              still.push(el);
            }
          }

          pending = still;
          if (!pending.length) teardown();
        };

        /* rAF keeps layout reads off the scroll thread; the timer is a backup
           in case rAF is frozen. sweep() is idempotent, so either may win. */
        const request = () => {
          if (queued) return;
          queued = true;
          window.requestAnimationFrame(sweep);
          window.setTimeout(sweep, 250);
        };

        /* If the tab is backgrounded mid-scroll, stop gambling on animation
           frames and just show whatever is left. */
        const onVisibility = () => {
          if (document.hidden) {
            pending.forEach(show);
            pending = [];
            teardown();
          }
        };

        function teardown() {
          window.removeEventListener('scroll', request);
          window.removeEventListener('resize', request);
          document.removeEventListener('visibilitychange', onVisibility);
        }

        window.addEventListener('scroll', request, { passive: true });
        window.addEventListener('resize', request, { passive: true });
        document.addEventListener('visibilitychange', onVisibility);
        window.addEventListener('load', request);

        request();
      })();
    </script>
  </body>
</html>
